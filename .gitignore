# Game media and extracted assets are local research inputs; do not publish them.
games/**/*.bin
games/**/*.iso
games/**/extracted/

# Ghidra workspace files are generated locally.
ghidra-project/

# Local scratch files, downloaded tools, logs, and Python cache.
.scratch/
**/__pycache__/
*.py[cod]
.DS_Store

# Tool caches and local environments.
.ruff_cache/
.pytest_cache/
.mypy_cache/
.pyright/
.venv/
venv/

# Secrets and local config (research scripts read keys from the environment).
.env
.env.*
!.env.example

# Ghidra project files if one is ever created outside ghidra-project/.
*.gpr
*.rep/
*.lock
*.lock~

# Other game media formats and dumps.
games/**/*.img
games/**/*.elf
*.sav
*.mcd

# ADR-0004: Sony-derived and corpus artifacts are never committed (see docs/LEGAL.md).
*.irx
*.IRX
*.a
*.o
SLES_*
SLUS_*
FILES.DAT
FILES.HDR
build/
