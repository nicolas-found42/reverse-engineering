  "arguments": {
    "purpose": "Classify each reverse-engineering area of the Ford Racing 2 PS2 corpus by evidence status for a completion matrix",
    "context": "Corpus: unchanged PAL SLES-517.05. Claims are limited to measured structure; semantics need separate evidence. User constraints: no debugger windows or focus stealing; milestone #2 evidence is bounded and issue #2 lists audio codec, mesh, full PTG and UI/text as separate investigations. Each item is one atomic finding with a single status; classify by that status.",
    "classes": [
      {
        "id": "verified_behavior",
        "description": "A behavior or fact checked against real observations or independent bytes/oracle on the real corpus, with a passing executable check and no known counterexample. Example: archive output SHA-256 equals independent extraction. Takes precedence over supported_bounded_profile only if the claim is about an observed behavior rather than a structural rule."
      },
      {
        "id": "supported_bounded_profile",
        "description": "A structural rule or contract verified on the exact corpus profile with negative tests, whose claims are explicitly limited (no semantics, no other regions). Example: header relations hold on all 548 PTG files. Use when the rule is structural and bounded, even if semantics are unknown."
      },
      {
        "id": "unresolved_interpretation",
        "description": "The data exists and is measured, but its meaning is not established; competing or no hypotheses survived testing. Example: palette location for tiled PTG files. Beats missing_observation when bytes are available and only meaning is missing."
      },
      {
        "id": "missing_observation",
        "description": "Establishing the fact needs a runtime or hardware observation that has not been made (e.g., a capture of a specific event). Beats missing_prerequisite when the only blocker is making the observation itself with tools already present."
      },
      {
        "id": "missing_prerequisite",
        "description": "Work is blocked by an absent tool, input, authorization or user decision that is not yet available (e.g., a windowless emulator mode, a native decompiler, a hardware oracle, or the user's scope decision)."
      },
      {
        "id": "not_yet_probed",
        "description": "No measurement has been made at all; neither structure nor meaning is known beyond file counts."
      },
      {
        "id": "manual_review",
        "description": "Genuinely ambiguous between classes; needs a human or independent reasoner."
      }
    ],
    "items": [
      {
        "id": "archive_hash_equality",
        "text": "Every one of the 990 extracted files has output length and SHA-256 equal to an independent archive read, and two real runtime loads match the same extraction."
      },
      {
        "id": "static_inventory",
        "text": "A complete 3446-function Ghidra export is inventoried with callers, callees, instruction bytes and string references, replayed as a passing static check."
      },
      {
        "id": "static_loader_stage_map",
        "text": "Six loader stages are tied to specific instruction bytes in the export and to runtime observations, with independent reasoner review accepting the claims."
      },
      {
        "id": "static_no_decompiled_c",
        "text": "No decompiled C exists because the native macOS decompiler is unavailable; pseudocode is not recovered."
      },
      {
        "id": "runtime_two_assets",
        "text": "Real PCSX2 observations exist for exactly two assets, one raw and one zlib, each repeated with matching outputs."
      },
      {
        "id": "runtime_other_assets",
        "text": "Loading events for other asset types or other game states have not been observed."
      },
      {
        "id": "bank_chain",
        "text": "All 27 sound-bank pairs have descriptor chains that cover the payload exactly."
      },
      {
        "id": "bank_adpcm_structure",
        "text": "All 305 bank sample spans satisfy PS-ADPCM block structure with zero violations, and the reference decoder equals ffmpeg's decoder sample for sample."
      },
      {
        "id": "bank_hardware_exactness",
        "text": "Whether the decoded audio is bit-exact with SPU2 hardware has no oracle and has not been established."
      },
      {
        "id": "bank_playback_path",
        "text": "How the game uploads and plays bank samples on the EE/IOP/SPU2 has not been observed."
      },
      {
        "id": "music_structure",
        "text": "All 20 music streams have two channels at 0x8000 interleave, a header turn count equal to the observed turns, and ADPCM-valid blocks, and 40 decoded excerpts equal ffmpeg."
      },
      {
        "id": "music_mih_word1",
        "text": "The meaning of the second header word of the .mih files is unknown; it is not a loop flag position."
      },
      {
        "id": "model_name_pool_end",
        "text": "The first u32 of all 56 models equals the name-pool end offset, with zero padding to a 16-byte boundary."
      },
      {
        "id": "model_geometry_layout",
        "text": "The layout of the geometry region after the name pool is unknown; the later header words are not a stable structure."
      },
      {
        "id": "ptg_gear_pixels",
        "text": "The supported sprite profile decodes the eight gear sprites and the user confirmed gear0 is uppercase R and gear1 uppercase N."
      },
      {
        "id": "ptg_header_relations",
        "text": "All 548 PTG files satisfy count == columns*rows, stride == cell and columns/rows == ceil(dimension/cell)."
      },
      {
        "id": "ptg_dd_layout",
        "text": "The 17 files with a 0xDDDDDDDD last word match an exact size formula and per-tile pointer records whose floats are row-major tile extents."
      },
      {
        "id": "ptg_palette",
        "text": "No palette has been located for tiled PTG files and their tile pointer values and descriptor constants have no known meaning."
      },
      {
        "id": "ptg_other_tiled_body",
        "text": "The body layout of the 491 header-only tiled PTG files is unmeasured beyond the header."
      },
      {
        "id": "ui_text_grammar",
        "text": "The 216 .dat, 45 .ui, 16 .cfg and 5 .mbf files have no measurement or recovered grammar."
      },
      {
        "id": "consumers_unmapped",
        "text": "The EE, IOP and VU code that consumes loaded sound, texture and model buffers has not been mapped."
      },
      {
        "id": "windowless_capture",
        "text": "A PCSX2 capture mode that opens no windows and takes no focus has not been built or verified; the current path opens debugger windows."
      },
      {
        "id": "native_decompiler",
        "text": "A native macOS Ghidra decompiler has not been built; it is not required by milestone #2."
      },
      {
        "id": "broader_scope_decision",
        "text": "The user has not stated whether the overall finish line includes mesh, VU and render reconstruction or whole-game decompilation."
      }
    ]
  },
