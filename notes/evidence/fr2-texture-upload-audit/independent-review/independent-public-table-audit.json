  "method": "Independent reference parser reads pinned PCSX2 public _blockTable/columnTable arrays and evaluates page/block/column equations directly; it does not call root check_texture_upload_maps.py or helper private _packed4_order. It separately compares every corpus item\u2019s independently indexed bytes with decode_indices.",
  "pcsx2_source": {
    "url": "https://raw.githubusercontent.com/PCSX2/pcsx2/81526d4dc7cc70e4ae75abb35a789417456c6d43/pcsx2/GS/GSTables.cpp",
    "path": ".scratch/mesh/codex-root/GSTables-pinned.cpp",
    "sha256": "4fc8ae3ef65d610ef8c1f8059b3a9ef8ae7fce5762a77e71410c7d0f0b12306b",
    "public_equation": "pxOffset: pageX*pageSize + blockTable[y/columnHeight][subpageX/columnWidth]*blockSize + columnTable[y%columnHeight][subpageX%columnWidth]",
    "source_lines": "GSTables.cpp 248-260; arrays _blockTable32/_blockTable16/_blockTable8/_blockTable4 and columnTable8/columnTable4"
  },
  "independent_formula": {
    "fmt3": "PSMCT32 word offset * 4 bytes maps the four upload bytes to raster labels; PSMT8 table yields byte address.",
    "fmt4": "PSMCT16 halfword offset * 4 nibbles maps each 16-bit upload texel to four source nibble labels; PSMT4 table yields nibble address.",
    "page_block_column": "Four public PCSX2 tables for each bpp profile are used; page width is buffer_width*64/page_width."
  },
