            "notes/evidence/fr2-geometry-consumer-audit/README.md"
          ]
        },
        {
          "contract_id": "model-geometry",
          "asset_type": "model geometry",
          "consumer": "FUN_0011ed90 parses the geometry section; FUN_0012d4b8 calls it and later routes selected parsed object fields through FUN_00113aa8 to a VU0 transform helper.",
          "bounds": "Top-level records are 0x34 bytes. Two unsigned halfword counts are read at +0x1c and +0x28. Variable payload spans are count/flag derived and 16-byte aligned.",
          "field_effects": "Group headers provide a count and flags; the serialized parser computes plane lengths and stores expanded pointers. The plane semantics (vertices, indices, normals, or other fields) are unresolved.",
          "transformations": "The parser expands serialized sections into allocated runtime records. One named-object path reads four mapped scalar fields for a transform; no particular variable plane is linked to that transform.",
          "allocation_lifetime": "Runtime allocation ownership and lifetime are unresolved.",
          "handoffs": "Static evidence reaches a parsed-object-to-VU0 transform path. Geometry-to-VIF/VU1 draw submission is not established.",
          "unknowns": [
            "Variable plane semantics",
            "direct geometry-plane consumer",
            "VIF1/VU1 rendering submission",
            "allocation lifetime"
          ],
          "evidence_bindings": [
